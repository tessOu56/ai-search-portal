# Normalize line endings: LF in repo, avoid Windows CRLF churn in diffs.
# After committing this file, run once: git add --renormalize . && git commit
* text=auto eol=lf

# Windows scripts need CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
