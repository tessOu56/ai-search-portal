{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "rules": {
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  },
  "ignore": [
    "build/**",
    ".cache/**",
    "node_modules/**",
    "public/**",
    "packages/shared-contracts/src/generated/**"
  ],
  "ignoreDependencies": [
    "eslint-formatter-gha",
    "@vitest/coverage-v8",
    "lucide-react",
    "@testing-library/react",
    "@testing-library/user-event",
    "@eslint/js",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks",
    "@is_tess/tokens"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreFiles": ["app/features/**/*.hooks.ts"],
  "ignoreIssues": {
    "app/shared/release-notes.server.ts": ["exports"],
    "app/components/shared/genui/GenUiRenderer.tsx": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "app/entry.client.tsx",
        "app/entry.server.tsx",
        "app/routes.ts",
        "app/routes/**/*.tsx",
        "app/routes/**/*.ts",
        "app/**/*.server.ts",
        "app/shared/**/*.{ts,tsx}",
        "e2e/**/*.ts"
      ],
      "project": ["app/**/*.{ts,tsx}"]
    },
    "packages/shared-contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "labs/*": {
      "entry": ["src/*.ts"]
    }
  }
}
