{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "rules": {
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  },
  "ignore": [
    "build/**",
    ".cache/**",
    "node_modules/**",
    "public/**",
    "packages/shared-contracts/src/generated/**"
  ],
  "ignoreDependencies": [
    "eslint-formatter-gha",
    "@vitest/coverage-v8",
    "isbot",
    "lucide-react",
    "@testing-library/react",
    "@testing-library/user-event",
    "eslint-import-resolver-typescript",
    "eslint-plugin-import",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreFiles": [
    "app/features/**/*.hooks.ts",
    "app/components/ui/Callout.tsx",
    "app/components/ui/Input.tsx"
  ],
  "ignoreIssues": {
    "app/shared/release-notes.server.ts": ["exports"],
    "app/components/shared/genui/GenUiRenderer.tsx": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "app/routes/**/*.tsx",
        "app/routes/**/*.ts",
        "app/**/*.server.ts",
        "app/shared/**/*.{ts,tsx}"
      ],
      "project": ["app/**/*.{ts,tsx}"]
    },
    "packages/shared-contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "labs/*": {
      "entry": ["src/*.ts"]
    }
  }
}
