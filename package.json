{
  "name": "ai-search-portal",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "build": "pnpm run build:contracts && pnpm run build:governance-domain && pnpm run build:agent-core && react-router build",
    "build:agent-core": "pnpm --filter @ai-search-portal/agent-core run build",
    "build:contracts": "pnpm run codegen:openapi && pnpm --filter @ai-search-portal/contracts run build",
    "build:governance-domain": "pnpm --filter @ai-search-portal/governance-domain run build",
    "codegen:openapi": "openapi-typescript specs/openapi/openapi.yaml -o packages/shared-contracts/src/generated/openapi-types.ts",
    "lint:openapi": "spectral lint specs/openapi/openapi.yaml",
    "check:node": "node -e \"const M=process.versions.node.split('.')[0]; if(M!=='22'){console.error('Portal requires Node 22.x (got '+process.versions.node+'). Use .nvmrc / brew node@22.'); process.exit(1)}\"",
    "verify:openapi-codegen": "pnpm run codegen:openapi && git diff --exit-code -- packages/shared-contracts/src/generated/openapi-types.ts",
    "dev": "react-router dev",
    "dev:api": "pnpm --filter ai-search-api dev",
    "dev:agent": "pnpm --filter @ai-search-portal/agent-runtime dev",
    "build:api": "pnpm run build:contracts && pnpm run build:governance-domain && pnpm --filter ai-search-api build",
    "test:api": "pnpm run build:contracts && pnpm run build:governance-domain && pnpm --filter ai-search-api test",
    "test:policies": "node scripts/test-policies.mjs",
    "test:agent": "pnpm run build:contracts && pnpm run build:agent-core && pnpm --filter @ai-search-portal/agent-core test && pnpm --filter @ai-search-portal/agent-runtime test",
    "test:labs": "pnpm run build:agent-core && pnpm --filter @ai-search-portal/lab-eval-runner test",
    "build:labs": "pnpm --filter @ai-search-portal/lab-eval-runner run build && pnpm --filter @ai-search-portal/lab-design-vibe run build",
    "turbo": "turbo",
    "eval:offline": "pnpm run build:agent-core && pnpm --filter @ai-search-portal/lab-eval-runner run build && pnpm --filter @ai-search-portal/lab-eval-runner run eval",
    "design:prompt": "pnpm --filter @ai-search-portal/lab-design-vibe run build && pnpm --filter @ai-search-portal/lab-design-vibe run prompt",
    "observability:up": "docker compose -f labs/observability/docker-compose.langfuse.yml up -d",
    "observability:down": "docker compose -f labs/observability/docker-compose.langfuse.yml down",
    "observability:smoke": "pnpm run build:agent-core && node labs/observability/smoke-trace.mjs",
    "typecheck:api": "pnpm --filter ai-search-api typecheck",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint --report-unused-disable-directives .",
    "lint:fix": "eslint --cache --cache-location ./node_modules/.cache/eslint --report-unused-disable-directives . --fix",
    "lint:strict": "eslint --max-warnings=0 --cache --cache-location ./node_modules/.cache/eslint --report-unused-disable-directives .",
    "lint:ci": "pnpm run lint:filenames && pnpm run lint:handlers && pnpm run lint:openapi && pnpm run verify:openapi-codegen && pnpm run lint:strict && pnpm run typecheck",
    "pr-gate": "pnpm run build && pnpm run test && pnpm run lint:ci",
    "check:peers": "pnpm ls react react-dom",
    "lint:filenames": "node scripts/lint-filenames.mjs",
    "lint:handlers": "node scripts/lint-handlers.mjs",
    "code-review:list": "node scripts/list-code-review-todos.mjs",
    "lint:report": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\" && eslint --format json --output-file reports/eslint-report.json .",
    "ci:failure-report": "node scripts/ci-failure-report.mjs",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "start": "react-router-serve ./build/server/index.js",
    "test": "pnpm run build:contracts && pnpm run build:governance-domain && pnpm run build:agent-core && vitest run && pnpm --filter @ai-search-portal/governance-domain test && pnpm --filter @ai-search-portal/agent-core test && pnpm --filter @ai-search-portal/agent-runtime test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "lighthouse": "node scripts/lighthouse-report.mjs",
    "test:watch": "vitest",
    "sync:metalcraft-knowledge": "node scripts/sync-metalcraft-knowledge.mjs",
    "check:metalcraft-knowledge": "CHECK_ONLY=1 node scripts/sync-metalcraft-knowledge.mjs",
    "sync:domain-glossary": "node scripts/sync-domain-glossary.mjs",
    "check:domain-glossary": "CHECK_ONLY=1 node scripts/sync-domain-glossary.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "react-router typegen && tsc -p tsconfig.json --noEmit && pnpm run typecheck:contracts && pnpm run typecheck:governance-domain && pnpm run typecheck:agent-core && pnpm run typecheck:agent-runtime && pnpm run typecheck:api",
    "typecheck:contracts": "pnpm --filter @ai-search-portal/contracts run typecheck",
    "typecheck:governance-domain": "pnpm --filter @ai-search-portal/governance-domain run typecheck",
    "typecheck:agent-core": "pnpm --filter @ai-search-portal/agent-core run typecheck",
    "typecheck:agent-runtime": "pnpm --filter @ai-search-portal/agent-runtime run typecheck",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "husky install || true",
    "predev": "pnpm run build:contracts && pnpm run build:governance-domain && pnpm run build:agent-core",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "size": "size-limit",
    "size:routes": "size-limit --json",
    "pretest": "pnpm run check:node",
    "prebuild": "pnpm run check:node",
    "prod:smoke": "node scripts/prod-smoke.mjs",
    "check:vercel-output": "node scripts/check-vercel-output.mjs",
    "observability:posthog:up": "docker compose -f labs/observability/docker-compose.posthog.yml up -d",
    "observability:posthog:down": "docker compose -f labs/observability/docker-compose.posthog.yml down"
  },
  "dependencies": {
    "@ai-search-portal/agent-core": "workspace:*",
    "@ai-search-portal/contracts": "workspace:*",
    "@ai-search-portal/governance-domain": "workspace:*",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/petrona": "^5.3.0",
    "@is_tess/components": "^0.1.14",
    "@is_tess/tokens": "^0.1.3",
    "@react-router/fs-routes": "7.18.4",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "@sentry/react-router": "^11.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.0",
    "lucide-react": "^0.563.0",
    "motion": "^12.42.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.4",
    "recharts": "^3.8.1",
    "remix-utils": "^8.8.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@changesets/cli": "^2.27.8",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@react-router/dev": "7.18.4",
    "@size-limit/file": "^12.1.0",
    "@stoplight/spectral-cli": "6.14.3",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/react-router": "1.3.6",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-gha": "^1.5.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^1.0.4",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "eslint-plugin-unicorn": "^55.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.4.0",
    "husky": "^9.0.11",
    "jsdom": "^29.1.1",
    "knip": "^5.80.0",
    "lighthouse": "^13.5.0",
    "lint-staged": "^15.2.2",
    "msw": "^2.15.0",
    "openapi-typescript": "7.6.1",
    "postcss": "^8.4.47",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "size-limit": "^12.1.0",
    "tailwindcss": "^3.4.17",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4",
    "vite-tsconfig-paths": "^5.1.1",
    "vitepress": "1.6.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": "22.x"
  },
  "size-limit": [
    {
      "name": "remix-client-assets",
      "path": [
        "build/client/assets/*.js",
        "!build/client/assets/sentry.client-*.js"
      ],
      "limit": "500 kB",
      "gzip": true
    },
    {
      "name": "route-home",
      "path": "build/client/assets/_index-*.js",
      "limit": "40 kB",
      "gzip": true
    },
    {
      "name": "route-insights",
      "path": "build/client/assets/insights._index-*.js",
      "limit": "40 kB",
      "gzip": true
    },
    {
      "name": "route-catalog-search",
      "path": "build/client/assets/catalog-search._index-*.js",
      "limit": "20 kB",
      "gzip": true
    },
    {
      "name": "route-metadata",
      "path": "build/client/assets/metadata._index-*.js",
      "limit": "20 kB",
      "gzip": true
    },
    {
      "name": "route-vitals",
      "path": "build/client/assets/vitals-*.js",
      "limit": "15 kB",
      "gzip": true
    },
    {
      "name": "shared-ui-root-chrome",
      "path": "build/client/assets/root-*.js",
      "limit": "85 kB",
      "gzip": true
    }
  ],
  "pnpm": {
    "overrides": {
      "vite": "^6.4.4",
      "react-router": "7.18.4",
      "proxy-addr": "^2.0.8",
      "compression": "^1.8.2",
      "brace-expansion@1": "1.1.20",
      "brace-expansion@2": "2.1.7",
      "nanoid@3": "3.3.18",
      "postcss@8": "8.5.23",
      "source-map-js": "1.2.2",
      "browserslist": "^4.28.7",
      "undici@>=7 <7.29.1": "^7.29.1",
      "fast-uri": "^3.1.8",
      "ajv@^8": "^8.18.0",
      "qs": "^6.16.0",
      "morgan": "^1.12.1",
      "body-parser": "^1.20.6",
      "js-yaml": "^4.3.2",
      "smol-toml": "^1.9.0",
      "lodash": "^4.17.23",
      "@vue/server-renderer": "^3.5.42"
    }
  }
}
