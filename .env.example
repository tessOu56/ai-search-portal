# Copy to `.env` or `.env.local` (gitignored). All keys are optional.
# `pnpm run dev` stays on offline fixtures when this file is empty.
# Never commit real secrets. Host keys: Vercel / GitHub Actions secrets only.
#
# React Router 7 (Vite, Node 22) loads `.env` / `.env.local` for the portal
# and in-process `@ai-search-portal/agent-core`. `pnpm run dev:api` and
# `pnpm run dev:agent` read the process environment (they do not auto-load this file).

# --- LLM (server-side only; omit = offline fixtures) ---
OPENAI_API_KEY=
# AGENT_LLM_MODE=openai          # mock | openai | gateway; live compose needs openai|gateway + the key
# OPENAI_MODEL=gpt-4o-mini

# --- Agent / RAG / tools ---
# AGENT_RUNTIME_URL=http://127.0.0.1:3002
# AGENT_PORT=3002
# AGENT_RAG_MODE=local
# AGENT_RAG_PACK=enterprise-mau
# AGENT_EXECUTE_TOOLS=1          # also enabled when *_API_URL is set
# ITEMS_API_URL=http://127.0.0.1:3001/api/v1/items
# ITEMS_API_TIMEOUT_MS=3000
# METADATA_API_URL=http://127.0.0.1:3001/api/metadata
# METADATA_API_TIMEOUT_MS=3000
# CONTEXT_API_URL=http://127.0.0.1:3001/api/context

# --- Portal ---
# CONTEXT_PACK=enterprise-mau
# AUDIT_LOG_PATH=./tmp/audit.jsonl   # JSONL append; default in-memory
#
# Fail-closed auth (required for governance writes, audit, chat, MCP).
# Production must set unique strong tokens. Playwright webServer uses the
# local values below when unset.
# ADMIN_API_TOKEN=dev-admin-token
# REVIEWER_API_TOKEN=dev-reviewer-token
# REQUESTER_API_TOKEN=dev-requester-token
# SESSION_SECRET=                    # defaults to ADMIN_API_TOKEN
# AGENT_RUNTIME_TOKEN=               # required in production for /v1/chat/stream
# TRUST_PROXY=1                      # honor last X-Forwarded-For hop (self-host)

# --- Backend / agent-runtime ---
# PORT=3001                          # backend listen port (`pnpm run dev:api`)
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# OPA_URL=http://localhost:8181      # live OPA; unset = in-process policy

# --- Client analytics (Vite; inlined into the browser bundle — no secrets) ---
# VITE_ANALYTICS_ENABLED=1
# VITE_ANALYTICS_ENDPOINT=http://localhost:19000

# --- Langfuse (optional tracing; see labs/observability) ---
# LANGFUSE_HOST=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Intentionally omitted (runtime/CI/tools, not local app config):
# NODE_ENV, CI, VERCEL, VITEST
# GitHub Actions deploy: VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
# Figma MCP: FIGMA_ACCESS_TOKEN, FIGMA_FILE_KEY (tools/figma-mcp)
# Maintainer scripts: PLATFORM_COMMAND_PATH, METALCRAFT_ROOT, METALCRAFT_SEED_JSON, CHECK_ONLY
# Docs-only names nothing reads: LANGFUSE_BASE_URL, MSW_DATASET_VERSION
